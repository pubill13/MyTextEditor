<UserControl x:Class="MyTextEditor.Diff.DiffTabView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MyTextEditor.Diff"
        Background="{DynamicResource WindowBrush}" Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
    <UserControl.Resources>
        <Style x:Key="CompactCommandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
        <Style x:Key="LockToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/>
            <Setter Property="ToolTip" Value="이쪽 내용의 편집과 병합 덮어쓰기를 막습니다"/>
            <Setter Property="AutomationProperties.Name" Value="편집 잠금"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Frame" CornerRadius="4" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5">
                    <Path x:Name="Lock" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" Stretch="Uniform" Data="M 4,7 L 4,4 C 4,0 10,0 10,4 M 2,7 L 12,7 12,14 2,14 Z"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Lock" Property="Data" Value="M 4,7 L 4,4 C 4,0 10,0 10,4 L 10,7 M 2,7 L 12,7 12,14 2,14 Z"/><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10,3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CompactCommandButton}" x:Name="PreviousButton" Content="↑ 이전 (F7)" ToolTip="이전 차이 (F7 / Alt+↑)" Click="Previous_Click"/>
                    <Button Style="{StaticResource CompactCommandButton}" x:Name="NextButton" Margin="6,0,0,0" Content="↓ 다음 (F8)" ToolTip="다음 차이 (F8 / Alt+↓)" Click="Next_Click"/>
                    <TextBlock x:Name="PositionText" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="0 / 0"/>
                    <TextBlock x:Name="StatisticsText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0">
                    <CheckBox x:Name="IgnoreWhitespaceCheck" Content="공백 무시" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="IgnoreCaseCheck" Margin="14,0,0,0" Content="대소문자 무시" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="IgnoreEmptyLinesCheck" Margin="14,0,0,0" Content="빈 줄 무시" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="ScrollSyncCheck" Margin="14,0,0,0" Content="스크롤 동기화" Checked="ScrollSync_Changed" Unchecked="ScrollSync_Changed"/>
                <CheckBox x:Name="AutoCompareCheck" Margin="14,0,0,0" Content="자동 비교" IsChecked="True" Checked="AutoCompare_Changed" Unchecked="AutoCompare_Changed" ToolTip="편집 후 자동 재비교. 큰 파일은 수동 비교를 권장합니다."/>
                    <CheckBox x:Name="MergeNextCheck" Margin="14,0,0,0" Content="병합 후 다음 차이" ToolTip="블록 병합 후 다음 미해결 차이로 이동합니다."/>
                    <Button Style="{StaticResource CompactCommandButton}" Content="다시 비교" ToolTip="다시 비교 (F5)" Click="Recompare_Click"/>
                    <Button x:Name="CancelCompareButton" Style="{StaticResource CompactCommandButton}" Content="계산 중단" Click="CancelCompare_Click" IsEnabled="False"/>
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="4,0">
                        <MenuItem Header="복사 ▾" ToolTip="전체 내용 및 현재 차이 복사" Height="26" Padding="8,2">
                            <MenuItem x:Name="CopyAllLeftButton" Header="오른쪽 전체 → 왼쪽" Click="CopyAllToLeft_Click"/>
                            <MenuItem x:Name="CopyAllRightButton" Header="왼쪽 전체 → 오른쪽" Click="CopyAllToRight_Click"/>
                            <Separator/>
                            <MenuItem x:Name="CopyDifferenceButton" Header="현재 차이 복사">
                                <MenuItem Header="왼쪽 복사" Tag="Left" Click="CopyBlockMenu_Click"/>
                                <MenuItem Header="오른쪽 복사" Tag="Right" Click="CopyBlockMenu_Click"/>
                                <MenuItem Header="양쪽 복사" Tag="Both" Click="CopyBlockMenu_Click"/>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </WrapPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CompactCommandButton}" x:Name="SwapButton" Margin="6,0,0,0" Content="⇄ 좌우 교환" Click="Swap_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="10,3" Background="{DynamicResource SurfaceAltBrush}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="색상 기준: 왼쪽 → 오른쪽" Margin="0,0,14,0" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="●" Foreground="#40A05B"/><TextBlock Text=" 오른쪽에만 있음 (추가)" Margin="0,0,14,0"/>
                    <TextBlock Text="●" Foreground="#D23F44"/><TextBlock Text=" 왼쪽에만 있음 (삭제)" Margin="0,0,14,0"/>
                    <TextBlock Text="●" Foreground="#CD971F"/><TextBlock Text=" 양쪽 내용 다름 (수정)" Margin="0,0,14,0"/>
                    <TextBlock Text="진한 부분: 줄 안에서 달라진 내용" Foreground="{DynamicResource MutedBrush}"/>
                </WrapPanel>
                <TextBlock x:Name="BlockRangeText" Margin="0,3,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="차이를 선택하면 좌우의 실제 반영 범위가 표시됩니다."/>
            </StackPanel>
        </Border>

        <Border x:Name="StaleBanner" DockPanel.Dock="Top" Visibility="Collapsed" Padding="10,7"
                Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CompactCommandButton}" Content="원본 다시 불러오기" Click="ReloadStale_Click"/>
                    <Button Style="{StaticResource CompactCommandButton}" Margin="6,0,0,0" Content="현재 Diff 내용으로 교체" Click="ForceApplyStale_Click"/>
                </StackPanel>
                <TextBlock x:Name="StaleText" VerticalAlignment="Center" Text="연결된 원본 문서가 변경되었습니다."/>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="비교 준비"/></StatusBarItem>
            <Separator/><StatusBarItem><ProgressBar x:Name="BusyProgress" Width="100" Height="5" IsIndeterminate="True" Visibility="Collapsed"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Border Padding="10,3" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1">
                    <WrapPanel>
                        <StackPanel Width="160" Margin="0,0,6,0">
                            <TextBlock x:Name="LeftTitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LeftMetaText" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource CompactCommandButton}" Content="소스 ▾" Click="LeftSourceMenu_Click"/>
                            <CheckBox x:Name="LeftReadOnlyCheck" Style="{StaticResource LockToggle}" Checked="ReadOnly_Changed" Unchecked="ReadOnly_Changed"/>
                            <Button Style="{StaticResource CompactCommandButton}" x:Name="ApplyLeftSourceButton" Margin="8,0,0,0" Content="원본 반영" Click="ApplyLeftSource_Click"/>
                            <Button Style="{StaticResource CompactCommandButton}" Margin="5,0,0,0" Content="새 문서" Click="ExtractLeft_Click"/>
                            <Button Style="{StaticResource CompactCommandButton}" Margin="5,0,0,0" Content="저장" Click="SaveLeft_Click"/>
                        </WrapPanel>
                    </WrapPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid AllowDrop="True" DragOver="Left_DragOver" Drop="Left_Drop"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ContentControl Grid.Row="1" x:Name="LeftEditorContainer"/><Border x:Name="LeftDropZone" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="4" Margin="6" Padding="6" AllowDrop="True" DragOver="Left_DragOver" Drop="Left_Drop"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="왼쪽: 아래에 직접 입력하거나 파일을 놓으세요" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="파일·열린 문서·클립보드로도 비교할 수 있습니다" Margin="0,3,0,5" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource CompactCommandButton}" Content="파일 선택" Click="ChooseLeftFile_Click"/><Button Style="{StaticResource CompactCommandButton}" Margin="6,0,0,0" Content="열린 문서" Click="ChooseLeftDocument_Click"/><Button Style="{StaticResource CompactCommandButton}" Margin="6,0,0,0" Content="클립보드" Click="UseLeftClipboard_Click"/></StackPanel></StackPanel></Border></Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Canvas x:Name="MergeGutterCanvas" ClipToBounds="True" SizeChanged="MergeGutter_SizeChanged"/>

                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Border Padding="10,3" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <WrapPanel>
                        <StackPanel Width="160" Margin="0,0,6,0">
                            <TextBlock x:Name="RightTitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="RightMetaText" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource CompactCommandButton}" Content="소스 ▾" Click="RightSourceMenu_Click"/>
                            <CheckBox x:Name="RightReadOnlyCheck" Style="{StaticResource LockToggle}" Checked="ReadOnly_Changed" Unchecked="ReadOnly_Changed"/>
                            <Button Style="{StaticResource CompactCommandButton}" x:Name="ApplyRightSourceButton" Margin="8,0,0,0" Content="원본 반영" Click="ApplyRightSource_Click"/>
                            <Button Style="{StaticResource CompactCommandButton}" Margin="5,0,0,0" Content="새 문서" Click="ExtractRight_Click"/>
                            <Button Style="{StaticResource CompactCommandButton}" Margin="5,0,0,0" Content="저장" Click="SaveRight_Click"/>
                        </WrapPanel>
                    </WrapPanel>
                </Border>
                <Grid Grid.Row="1" AllowDrop="True" DragOver="Right_DragOver" Drop="Right_Drop"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ContentControl Grid.Row="1" x:Name="RightEditorContainer"/><Border x:Name="RightDropZone" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="4" Margin="6" Padding="6" AllowDrop="True" DragOver="Right_DragOver" Drop="Right_Drop"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="오른쪽: 아래에 직접 입력하거나 파일을 놓으세요" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="파일·열린 문서·클립보드로도 비교할 수 있습니다" Margin="0,3,0,5" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource CompactCommandButton}" Content="파일 선택" Click="ChooseRightFile_Click"/><Button Style="{StaticResource CompactCommandButton}" Margin="6,0,0,0" Content="열린 문서" Click="ChooseRightDocument_Click"/><Button Style="{StaticResource CompactCommandButton}" Margin="6,0,0,0" Content="클립보드" Click="UseRightClipboard_Click"/></StackPanel></StackPanel></Border></Grid>
            </Grid>
            <local:DifferenceMap x:Name="DifferenceMapView" Grid.Column="3" ToolTip="차이 지도: 클릭하여 가까운 차이로 이동"/>
        </Grid>
    </DockPanel>
</UserControl>


