<Window x:Class="MyTextEditor.Diff.DiffWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비교 / 병합 작업 공간" Width="1320" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Closing="Window_Closing" LocationChanged="Window_PlacementChanged" SizeChanged="Window_PlacementChanged"
        PreviewKeyDown="Window_PreviewKeyDown" DpiChanged="Window_DpiChanged">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="다른 비교 닫기" Click="CloseOthers_Click"/>
                    <Button Margin="6,0,0,0" Content="모든 비교 닫기" Click="CloseAll_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Width="30" Height="28" Padding="0" Content="＋" ToolTip="새 비교 탭" Click="AddTab_Click"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                               Text="파일 두 개를 함께 놓으면 좌우에 자동으로 배치됩니다."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="새 비교를 시작하세요."/></StatusBarItem>
            <Separator/><StatusBarItem><ProgressBar x:Name="BusyProgress" Width="100" Height="5" IsIndeterminate="True" Visibility="Collapsed"/></StatusBarItem>
        </StatusBar>
        <TabControl x:Name="ComparisonTabs" SelectionChanged="ComparisonTabs_SelectionChanged"/>
    </DockPanel>
</Window>
