<Window x:Class="MyTextEditor.Diff.DiffWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비교 / 병합 작업 공간" Width="1320" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Closing="Window_Closing" LocationChanged="Window_PlacementChanged" SizeChanged="Window_PlacementChanged"
        KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown" DpiChanged="Window_DpiChanged">
    <Window.Resources>
        <Style x:Key="CompactCommandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="새 비교를 시작하세요."/></StatusBarItem>
            <Separator/><StatusBarItem><ProgressBar x:Name="BusyProgress" Width="100" Height="5" IsIndeterminate="True" Visibility="Collapsed"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <TabControl x:Name="ComparisonTabs" SelectionChanged="ComparisonTabs_SelectionChanged">
                <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <ScrollViewer Margin="0,0,146,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False"><TabPanel IsItemsHost="True"/></ScrollViewer>
                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                </Grid></ControlTemplate></TabControl.Template>
            </TabControl>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Background="{DynamicResource SurfaceBrush}">
                <Button Style="{StaticResource CompactCommandButton}" Width="26" Height="26" Padding="0" ToolTip="새 비교 탭" AutomationProperties.Name="새 비교 탭" Click="AddTab_Click"><Path Width="12" Height="12" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3" Data="M 6,0 L 6,12 M 0,6 L 12,6"/></Button>
                <Menu Background="Transparent" Height="28"><MenuItem Header="작업 공간" Padding="8,3">
                    <MenuItem StaysOpenOnClick="True"><MenuItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="글자 크기" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="DiffFontSizeCombo" Width="64" Height="26" Padding="4,2" IsEditable="True" ToolTip="6~72pt · Ctrl+휠 · Ctrl+0은 11pt" SelectionChanged="DiffFontSize_SelectionChanged" LostKeyboardFocus="DiffFontSize_LostKeyboardFocus" PreviewKeyDown="DiffFontSize_PreviewKeyDown"/>
                    </StackPanel></MenuItem.Header></MenuItem><Separator/>
                    <MenuItem Header="다른 비교 닫기" Click="CloseOthers_Click"/><MenuItem Header="모든 비교 닫기" Click="CloseAll_Click"/><MenuItem Header="도움말" Click="Help_Click"/>
                </MenuItem></Menu>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
