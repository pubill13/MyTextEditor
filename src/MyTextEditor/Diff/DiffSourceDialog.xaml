<Window x:Class="MyTextEditor.Diff.DiffSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비교 대상 선택" Width="680" Height="390" MinWidth="620" MinHeight="350"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Diff / Merge" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,16" Foreground="{DynamicResource MutedBrush}"
                       Text="열린 문서, 파일, 클립보드 또는 현재 선택 영역을 서로 비교합니다."/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Padding="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel>
                    <TextBlock Text="LEFT" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    <ComboBox x:Name="LeftKindCombo" Margin="0,10,0,8" SelectionChanged="SourceKind_SelectionChanged">
                        <ComboBoxItem Tag="OpenDocument">열린 문서</ComboBoxItem><ComboBoxItem Tag="File">파일</ComboBoxItem>
                        <ComboBoxItem Tag="Clipboard">클립보드</ComboBoxItem><ComboBoxItem Tag="Selection">현재 선택 영역</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="LeftDocumentCombo" DisplayMemberPath="DisplayName"/>
                    <Grid x:Name="LeftFilePanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="LeftFileText" IsReadOnly="True"/><Button Grid.Column="1" Margin="8,0,0,0" Content="찾아보기…" Click="BrowseLeft_Click"/>
                    </Grid>
                    <TextBlock x:Name="LeftHint" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel>
                    <TextBlock Text="RIGHT" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    <ComboBox x:Name="RightKindCombo" Margin="0,10,0,8" SelectionChanged="SourceKind_SelectionChanged">
                        <ComboBoxItem Tag="OpenDocument">열린 문서</ComboBoxItem><ComboBoxItem Tag="File">파일</ComboBoxItem>
                        <ComboBoxItem Tag="Clipboard">클립보드</ComboBoxItem><ComboBoxItem Tag="Selection">현재 선택 영역</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="RightDocumentCombo" DisplayMemberPath="DisplayName"/>
                    <Grid x:Name="RightFilePanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RightFileText" IsReadOnly="True"/><Button Grid.Column="1" Margin="8,0,0,0" Content="찾아보기…" Click="BrowseRight_Click"/>
                    </Grid>
                    <TextBlock x:Name="RightHint" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,12,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="82" Content="취소" IsCancel="True"/>
            <Button MinWidth="112" Margin="8,0,0,0" Content="비교 시작" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
