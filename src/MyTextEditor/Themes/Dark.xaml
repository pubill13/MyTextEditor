<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowColor">#11151C</Color>
    <Color x:Key="SurfaceColor">#191F29</Color>
    <Color x:Key="SurfaceAltColor">#202734</Color>
    <Color x:Key="BorderColor">#354052</Color>
    <Color x:Key="TextColor">#ECF0F6</Color>
    <Color x:Key="MutedColor">#A3AEC2</Color>
    <Color x:Key="AccentColor">#5B8DEF</Color>
    <Color x:Key="AccentHoverColor">#79A2F2</Color>
    <Color x:Key="SelectionColor">#294677</Color>
    <Color x:Key="DangerColor">#FF6B78</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
</ResourceDictionary>
