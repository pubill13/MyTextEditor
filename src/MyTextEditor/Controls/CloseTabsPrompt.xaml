<Window x:Class="MyTextEditor.Controls.CloseTabsPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="모든 탭 닫기" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        FocusManager.FocusedElement="{Binding ElementName=Save}">
    <StackPanel Margin="18">
        <TextBlock x:Name="Question" TextWrapping="Wrap" />
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="Save" Content="예" IsDefault="True" Click="Answer_Click"/>
            <Button x:Name="Discard" Content="아니오" Click="Answer_Click"/>
            <Button x:Name="DiscardAll" Content="모두 아니오" Click="Answer_Click"/>
            <Button Content="취소" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
