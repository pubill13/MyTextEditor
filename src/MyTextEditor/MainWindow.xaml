<Window x:Class="MyTextEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MyTextEditor.Models" xmlns:core="clr-namespace:MyTextEditor.Core;assembly=MyTextEditor.Core"
        Title="OmniEdit" Icon="/OmniEdit;component/Assets/AppIcon.ico" MinWidth="1040" MinHeight="680"
        Width="1380" Height="860" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" KeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" Drop="Window_Drop" DpiChanged="Window_DpiChanged">
    <Window.Resources>
        <models:PointsToDipsConverter x:Key="PointsToDips"/>
        <Style x:Key="PanelSectionHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PanelFunctionTitle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26"/><Setter Property="Padding" Value="9,2"/><Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="PanelToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleBorder" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ToggleBorder" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="CompactToolbarToggle" TargetType="ToggleButton" BasedOn="{StaticResource PanelToggleStyle}">
            <Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="9,2"/><Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="CompactDocumentTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="8,1"/>
        </Style>
        <Style x:Key="CompactSearchResultItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="SearchResultRowTemplate" DataType="{x:Type models:SearchResultRow}">
            <Grid Margin="4,0" TextElement.FontFamily="{DynamicResource EditorFontFamily}" TextElement.FontSize="{DynamicResource EditorFontSize}"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto" MinWidth="94" SharedSizeGroup="ResultLineNumberColumn"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultMarker" Text="●" Foreground="{DynamicResource AccentBrush}" FontSize="9" VerticalAlignment="Center" />
                <TextBlock FontSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource PointsToDips}}" x:Name="ResultLineNumber" Grid.Column="1" Text="{Binding LineNumber}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock FontSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource PointsToDips}}" Grid.Column="2" Text="{Binding SourceLabel}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock FontSize="{Binding Path=(TextElement.FontSize), RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource PointsToDips}}" x:Name="ResultText" Grid.Column="3" Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsContext}" Value="True">
                    <Setter TargetName="ResultMarker" Property="Text" Value="↳" />
                    <Setter TargetName="ResultMarker" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter TargetName="ResultLineNumber" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter TargetName="ResultText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter TargetName="ResultText" Property="Margin" Value="6,0,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Background="{DynamicResource WindowBrush}">
        <Menu DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="새 문서(_N)" InputGestureText="Ctrl+N" Click="New_Click" />
                <MenuItem Header="열기(_O)…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <Separator />
                <MenuItem Header="저장(_S)" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem Header="다른 이름으로 저장(_A)…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                <Separator />
                <MenuItem x:Name="EncodingFileMenu" Header="인코딩" SubmenuOpened="EncodingMenu_Opened">
                    <MenuItem Header="인코딩 선택" IsEnabled="False"/>
                </MenuItem>
                <MenuItem x:Name="RecentFilesMenu" Header="최근 파일" />
                <Separator />
                <MenuItem Header="현재 탭 닫기(_W)" InputGestureText="Ctrl+W" Click="CloseTab_Click" />
                <MenuItem Header="모든 탭 닫기" InputGestureText="Ctrl+Shift+W" Click="CloseAllTabs_Click" />
                <MenuItem Header="끝내기(_X)" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem x:Name="UndoMenuItem" Header="실행 취소" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem Header="다시 실행" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="모두 선택" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                <Separator />
                <MenuItem Header="찾기" InputGestureText="Ctrl+F" Click="Find_Click" />
                <MenuItem Header="바꾸기" InputGestureText="Ctrl+H" Click="Replace_Click" />
                <MenuItem Header="다음 검색 결과" InputGestureText="F3" Click="FindNext_Click" />
                <MenuItem Header="이전 검색 결과" InputGestureText="Shift+F3" Click="FindPrevious_Click" />
                <MenuItem Header="줄 번호로 이동…" InputGestureText="Ctrl+G" Click="GoToLine_Click" />
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem x:Name="ToolsMenuItem" Header="도구 패널" IsCheckable="True" IsChecked="True" Click="ToggleTools_Click" />
                <MenuItem x:Name="ResultsMenuItem" Header="결과 패널" IsCheckable="True" IsChecked="False" Click="ToggleResults_Click" />
                <MenuItem x:Name="SplitDocumentsMenuItem" Header="문서 좌우 분할" IsCheckable="True" Click="ToggleDocumentSplit_Click" />
                <MenuItem x:Name="WordWrapMenuItem" Header="자동 줄바꿈" IsCheckable="True" Click="WordWrap_Click" ToolTip="표시만 줄바꿈하며 파일 내용은 바꾸지 않습니다." />
                <Separator />
                <MenuItem x:Name="ThemeMenu" Header="색상 테마" />
                <MenuItem Header="글자 확대" InputGestureText="Ctrl++" Click="ZoomIn_Click" />
                <MenuItem Header="글자 축소" InputGestureText="Ctrl+-" Click="ZoomOut_Click" />
                <MenuItem Header="글자 크기 초기화 (15pt)" InputGestureText="Ctrl+0" Click="ZoomReset_Click" />
            </MenuItem>
            <MenuItem Header="도움말(_H)" Click="Help_Click" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="StatusMessage" Text="준비" /></StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="CaretStatus" Text="줄 1, 열 1" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="LineCountStatus" Text="1줄" /></StatusBarItem>
            <Separator />
            <StatusBarItem><Button Padding="4,0" Margin="0" ToolTip="저장 인코딩 변경 / 다른 인코딩으로 다시 열기" Click="EncodingStatus_Click"><TextBlock x:Name="EncodingStatus" Text="UTF-8"/></Button></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="NewLineStatus" Text="CRLF" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top" Padding="8,1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="MainToolbarGrid">
                <Grid.Resources><Style TargetType="Button" BasedOn="{StaticResource CompactToolbarButton}"/></Grid.Resources><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="PrimaryToolbarPanel" Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource CompactToolbarButton}" Content="새 문서" ToolTip="새 문서 (Ctrl+N)" Click="New_Click" />
                    <Button Style="{StaticResource CompactToolbarButton}" Content="열기" ToolTip="파일 열기 (Ctrl+O)" Click="Open_Click" />
                    <Button Style="{StaticResource CompactToolbarButton}" Content="저장" ToolTip="저장 (Ctrl+S)" Click="Save_Click" />
                    <Border Width="1" Margin="10,3" Background="{DynamicResource BorderBrush}" />
                    <ToggleButton x:Name="ToolsToggleButton" Content="검색·정리" Style="{StaticResource CompactToolbarToggle}" IsChecked="True" ToolTip="검색·정리 패널 표시/숨기기 (검색 Ctrl+F, 치환 Ctrl+H)" Click="ToggleToolsButton_Click"/>
                    <Border Width="1" Margin="8,3" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="부가 기능" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource MutedBrush}"/>
                    <ToggleButton x:Name="SyncFilesMenuItem" Content="파일 변경 모니터링" Style="{StaticResource CompactToolbarToggle}" ToolTip="파일 변경 모니터링 · 저장하지 않은 수정은 보호합니다." Click="SyncFiles_Click"/>
                    <ToggleButton x:Name="DiffToggleButton" Content="비교/병합" Style="{StaticResource CompactToolbarToggle}" ToolTip="비교/병합 창 표시·숨기기 (작업 유지)" Click="ToggleDiff_Click"/>
                    <ToggleButton x:Name="MacroToggleButton" Content="매크로" Style="{StaticResource CompactToolbarToggle}" ToolTip="매크로 창 표시·숨기기 (작업 유지)" Click="ToggleMacro_Click"/>
                    <Border Width="1" Margin="8,3" Background="{DynamicResource BorderBrush}" />
                    <Button x:Name="UndoButton" Style="{StaticResource CompactToolbarButton}" Content="실행 취소" ToolTip="실행 취소 (Ctrl+Z)" Click="Undo_Click" />
                    <Button Style="{StaticResource CompactToolbarButton}" Content="↷" ToolTip="다시 실행 (Ctrl+Y)" Click="Redo_Click" />
                </StackPanel>
                <Grid x:Name="FavoriteToolbarHost" Grid.Column="1" ClipToBounds="True" Margin="4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="FavoriteToolsPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Button x:Name="FavoriteOverflowButton" Grid.Column="1" Content="즐겨찾기 ▾" Height="26" Padding="8,2" ToolTip="화면에 표시되지 않은 즐겨찾기 도구" Click="FavoriteOverflow_Click" Visibility="Collapsed"/>
                    <Button x:Name="FavoriteToolsEditButton" Grid.Column="2" Content="☆ 편집" Height="26" Padding="8,2" ToolTip="즐겨찾기 고정·해제" Click="FavoriteToolsEdit_Click" />
                </Grid>
                <StackPanel x:Name="ToolbarFontPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="글꼴" Margin="8,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox x:Name="FontFamilyCombo" Width="150" Height="26" IsEditable="True" IsTextSearchEnabled="True"
                              ToolTip="설치된 글꼴 검색" SelectionChanged="FontFamilyCombo_SelectionChanged" LostKeyboardFocus="FontFamilyCombo_LostKeyboardFocus" />
                    <TextBlock Text="크기" Margin="8,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox x:Name="FontSizeCombo" Width="64" Height="26" IsEditable="True" ToolTip="6~72pt 정수 입력" LostKeyboardFocus="FontSize_LostFocus" PreviewKeyDown="FontSize_KeyDown" SelectionChanged="FontSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="6"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/><ComboBoxItem Content="28"/><ComboBoxItem Content="36"/><ComboBoxItem Content="48"/><ComboBoxItem Content="60"/><ComboBoxItem Content="72"/>
                    </ComboBox>
                    <Button Content="◐" ToolTip="다음 색상 테마" Click="ToggleTheme_Click" />
                </StackPanel>
                <StackPanel x:Name="ToolbarOverflowPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button x:Name="ToolbarOverflowButton" Content="글꼴 · 크기 ⋯" Height="26" ToolTip="글꼴과 크기 설정" Click="ToolbarOverflowButton_Click" />
                    <Button Content="◐" Height="26" ToolTip="다음 색상 테마" Click="ToggleTheme_Click" />
                    <Popup x:Name="ToolbarOverflowPopup" PlacementTarget="{Binding ElementName=ToolbarOverflowButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Padding="10" Margin="0,4,0,0" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Width="230">
                                <TextBlock Text="글꼴" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                                <ComboBox x:Name="OverflowFontFamilyCombo" Height="26" IsEditable="True" IsTextSearchEnabled="True"
                                          ToolTip="설치된 글꼴 검색" SelectionChanged="OverflowFontFamilyCombo_SelectionChanged" LostKeyboardFocus="OverflowFontFamilyCombo_LostKeyboardFocus" />
                                <TextBlock Text="크기" Margin="0,8,0,4" Foreground="{DynamicResource MutedBrush}" />
                                <ComboBox x:Name="OverflowFontSizeCombo" Height="26" IsEditable="True" ToolTip="6~72pt 정수 입력" LostKeyboardFocus="FontSize_LostFocus" PreviewKeyDown="FontSize_KeyDown" SelectionChanged="OverflowFontSizeCombo_SelectionChanged">
                                    <ComboBoxItem Content="6"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/><ComboBoxItem Content="28"/><ComboBoxItem Content="36"/><ComboBoxItem Content="48"/><ComboBoxItem Content="60"/><ComboBoxItem Content="72"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ToolSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="ToolColumn" Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="ResultSplitterRow" Height="0" />
                <RowDefinition x:Name="ResultRow" Height="0" MinHeight="0" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                <Grid x:Name="DocumentPanesGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DocumentPaneSplitterColumn" Width="0"/><ColumnDefinition x:Name="RightDocumentColumn" Width="0"/></Grid.ColumnDefinitions>
                    <TabControl x:Name="DocumentTabs" ItemContainerStyle="{StaticResource CompactDocumentTab}" ItemsSource="{Binding LeftDocuments}" SelectionChanged="DocumentTabs_SelectionChanged" PreviewMouseDown="DocumentPane_MouseDown" GotKeyboardFocus="DocumentPane_GotKeyboardFocus">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="탭 닫기" Click="DocumentTabMenuClose_Click" />
                                            <MenuItem Header="이 창을 제외하고 모두 닫기" Click="DocumentTabMenuCloseOthers_Click" />
                                            <MenuItem Header="모든 탭 닫기" Click="DocumentTabMenuCloseAll_Click" />
                                            <MenuItem Header="다른 쪽으로 이동" Click="MoveDocumentPane_Click" />
                                            <Separator />
                                            <MenuItem Header="전체 경로 복사" Click="DocumentTabMenuCopyPath_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Text="{Binding TabTitle}" Margin="0,0,8,0" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding TabTitle}" />
                                    <Button Content="×" Width="24" Height="24" Padding="2,0" Margin="0" Background="Transparent" BorderThickness="0"
                                            ToolTip="탭 닫기" Tag="{Binding}" Click="TabClose_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Editor}" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
                    <TabControl x:Name="RightDocumentTabs" ItemContainerStyle="{StaticResource CompactDocumentTab}" Grid.Column="2" Visibility="Collapsed" ItemsSource="{Binding RightDocuments}" ItemTemplate="{Binding ItemTemplate, ElementName=DocumentTabs}" ContentTemplate="{Binding ContentTemplate, ElementName=DocumentTabs}" SelectionChanged="DocumentTabs_SelectionChanged" PreviewMouseDown="DocumentPane_MouseDown" GotKeyboardFocus="DocumentPane_GotKeyboardFocus" />
                    <Border x:Name="EmptyDocumentState" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
                            <Viewbox Width="72" Height="72" Margin="0,0,0,18">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M14,5 H39 L52,18 V58 H14 Z" Fill="{DynamicResource SelectionBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
                                    <Path Data="M39,5 V18 H52 M23,30 H43 M23,39 H43 M23,48 H36" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="새 문서에서 시작하세요" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="파일을 열거나 새 문서를 만들어 검색과 텍스트 정리 도구를 사용해 보세요." Margin="0,10" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="새 문서" Style="{StaticResource PrimaryButton}" Click="New_Click" />
                                <Button Content="파일 열기" Click="Open_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" DragCompleted="PanelSplitter_DragCompleted" />

            <Border x:Name="ToolPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" KeyDown="ToolPanel_KeyDown">
                <DockPanel>
                <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="DetachToolsButton" DockPanel.Dock="Right" Width="28" Height="28" Padding="5" AutomationProperties.Name="검색·정리를 별도 창으로" ToolTip="검색·정리를 별도 창으로 열기" Click="DetachTools_Click"><Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Data="M5,1 H15 V11 H12 M1,5 H11 V15 H1 Z"/></Button><Button DockPanel.Dock="Right" Content="패널 숨기기 ×" Height="28" Padding="8,2" ToolTip="패널 숨기기 (패널 안에서 Esc) · Ctrl+F로 다시 검색" Click="HideTools_Click"/>
                        <StackPanel><TextBlock Text="검색·정리" FontWeight="SemiBold"/><TextBlock x:Name="ToolsTargetText" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                    </DockPanel>
                </Border>
                <TabControl Margin="0" x:Name="ToolTabs" SelectionChanged="ToolTabs_SelectionChanged">
                    <TabItem Header="검색 조건">
                        <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="6,4" Background="{DynamicResource SurfaceBrush}">
                            <WrapPanel>
                                <Button Content="최근 검색 ▾" Padding="8,5" ToolTip="저장된 최근 검색 조건 불러오기" Click="RecentSearches_Click" />
                                <Button Content="조건 초기화" Padding="8,5" ToolTip="세 검색칸만 비웁니다. 옵션과 최근 검색은 유지합니다." Click="ResetConditions_Click" />
                                <Button Content="?" Padding="8,5" ToolTip="검색 도움말" Click="SearchHelp_Click"/>
                            </WrapPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Padding="8,5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <WrapPanel>
                                <Button x:Name="SearchButton" Content="찾기" Style="{StaticResource PrimaryButton}" ToolTip="다음 일치 위치로 이동 (Enter)" Click="FindOccurrence_Click" />
                                <Button x:Name="SearchAllButton" Content="모두 찾기" ToolTip="현재 문서의 결과를 아래에 모아 표시" Click="Search_Click" />
                                <Button x:Name="SearchOpenButton" Content="열린 파일 모두" ToolTip="열린 문서 전체에서 검색" Click="SearchOpenDocuments_Click" />
                                <Button x:Name="CancelFolderSearchButton" Content="검색 중단" Visibility="Collapsed" Click="CancelFolderSearch_Click" />
                            </WrapPanel>
                        </Border>
                        <ScrollViewer x:Name="SearchScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource PanelSectionHeader}"><TextBlock Text="검색" FontSize="17"/></Border>
                                        <TextBlock Text="찾을 텍스트"/><TextBox x:Name="LiteralFindBox" ToolTip="단어 또는 문장을 입력하고 Enter로 다음 위치를 찾습니다." KeyDown="LiteralFindBox_KeyDown" TextChanged="SimpleCondition_TextChanged" />
                                        <CheckBox x:Name="UseConditionSearchCheck" Content="포함·제외 조건 사용" ToolTip="일반 찾을 텍스트 대신 아래 모두 포함·하나라도 포함·제외 조건으로 검색합니다." Checked="SearchMode_Changed" Unchecked="SearchMode_Changed" Margin="0,7,0,0" />
                                        <CheckBox x:Name="FolderSearchCheck" Content="폴더 내 검색" Margin="0,7,0,0" Checked="FolderSearchMode_Changed" Unchecked="FolderSearchMode_Changed" ToolTip="폴더를 선택한 뒤 모두 찾기로 검색합니다." />
                                        <StackPanel x:Name="FolderSearchOptionsPanel" Margin="0,7,0,7" Visibility="Collapsed">
                                            <TextBlock Text="검색할 폴더" />
                                            <TextBox x:Name="SearchFolderPathBox" IsReadOnly="True" TextChanged="SearchFolderPath_Changed" ToolTip="선택한 폴더에서 검색합니다." />
                                            <WrapPanel>
                                                <Button Content="폴더 선택…" Click="ChooseSearchFolder_Click" ToolTip="검색 대상 폴더 선택" />
                                                <Button x:Name="UseCurrentDocumentFolderButton" Content="현재 문서 폴더" Click="UseCurrentDocumentFolder_Click" ToolTip="현재 문서 파일이 있는 폴더를 검색 폴더로 설정" />
                                            </WrapPanel>
                                            <CheckBox x:Name="IncludeSubfoldersCheck" Content="하위 폴더 포함" ToolTip="선택한 폴더 안의 하위 폴더도 함께 검색합니다." IsChecked="True" />
                                            <TextBlock Text="파일 형식 (; 구분)"/><TextBox x:Name="FolderPatternBox" Text="{x:Static core:FolderSearchOptions.DefaultFilePatterns}" LostKeyboardFocus="FolderPattern_LostFocus" ToolTip="예: *.txt;*.log — 세미콜론으로 구분합니다. 비우면 기본 형식 목록으로 복원합니다." />
                                        </StackPanel>
                                        <StackPanel x:Name="ConditionInputsPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource PanelSectionHeader}" Margin="0,12,0,7"><TextBlock Text="조건 검색"/></Border>
                                            <TextBlock x:Name="ConditionInputHint" Text="여러 검색어는 쉼표로 구분합니다." TextWrapping="NoWrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="ConditionInputExample" Text="예: 오류, 경고, 실패" TextWrapping="NoWrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                            <TextBlock Text="모두 포함" Margin="0,5,0,3"/><TextBox x:Name="SimpleAllBox" ToolTip="예: AAA, BBB — 쉼표로 추가" TextChanged="SimpleCondition_TextChanged" KeyDown="SearchInput_KeyDown" GotKeyboardFocus="SearchField_GotKeyboardFocus"/>
                                            <WrapPanel x:Name="SimpleAllTags" Margin="0,4,0,0" />
                                            <TextBlock Text="하나라도 포함" Margin="0,8,0,3"/><TextBox x:Name="SimpleAnyBox" ToolTip="예: 오류, 경고 — 쉼표로 추가" TextChanged="SimpleCondition_TextChanged" KeyDown="SearchInput_KeyDown" GotKeyboardFocus="SearchField_GotKeyboardFocus"/>
                                            <WrapPanel x:Name="SimpleAnyTags" Margin="0,4,0,0" />
                                            <TextBlock Text="제외" Margin="0,8,0,3"/><TextBox x:Name="SimpleExcludeBox" ToolTip="예: 테스트 — 쉼표로 추가" TextChanged="SimpleCondition_TextChanged" KeyDown="SearchInput_KeyDown" GotKeyboardFocus="SearchField_GotKeyboardFocus"/>
                                            <WrapPanel x:Name="SimpleExcludeTags" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border x:Name="ConditionSummaryBorder" Visibility="Collapsed" Margin="0,10,0,0" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}">
                                            <TextBlock x:Name="ConditionSummaryText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource PanelSectionHeader}"><TextBlock Text="검색 옵션"/></Border>
                                        <TextBlock Text="검색 방식" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                        <WrapPanel>
                                            <CheckBox x:Name="MatchCaseCheck" Content="대소문자 구분" ToolTip="켜면 ABC와 abc를 서로 다른 텍스트로 검색합니다." />
                                            <CheckBox x:Name="WholeWordCheck" Content="완전한 단어" ToolTip="예: error 검색 시 errors 같은 단어의 일부는 제외합니다." />
                                        </WrapPanel>
                                        <Expander x:Name="SearchResultOptionsExpander" Header="결과 표시" IsExpanded="False" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}">
                                            <StackPanel Margin="0,5,0,0">
                                            <Grid Margin="4,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="주변 줄 함께 보기" VerticalAlignment="Center" ToolTip="선택한 줄 수만큼 일치 줄의 앞뒤를 함께 표시합니다."/>
                                            <ComboBox x:Name="ContextLinesCombo" Grid.Column="1" AutomationProperties.Name="주변 줄 함께 보기" ToolTip="0은 일치 줄만, 2는 앞뒤 2줄도 표시합니다. 열린 파일 전체 검색에는 적용되지 않습니다." HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="0" IsSelected="True"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="5"/>
                                            </ComboBox>
                                            </Grid>
                                            <TextBlock Text="현재 문서·폴더 검색에 적용됩니다.&#10;열린 파일 전체 검색에는 적용되지 않습니다." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,3,4,0"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="텍스트 정리">
                        <DockPanel>
                        <DockPanel.Resources>
                            <Style x:Key="TransformActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Height" Value="26"/>
                                <Setter Property="Padding" Value="6,1"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </Style>
                        </DockPanel.Resources>
                        <Button Style="{StaticResource TransformActionButton}" x:Name="ToolsUndoButton" DockPanel.Dock="Top" Content="실행 취소" ToolTip="현재 문서의 최근 편집을 되돌립니다 (Ctrl+Z)" Click="Undo_Click" HorizontalAlignment="Left"/>
                        <ScrollViewer x:Name="TransformScrollViewer" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource PanelCard}" Padding="8">
                                    <StackPanel>
                                        <DockPanel>
                        <DockPanel.Resources>
                            <Style x:Key="TransformActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Height" Value="26"/>
                                <Setter Property="Padding" Value="6,1"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </Style>
                        </DockPanel.Resources><Border Style="{StaticResource PanelSectionHeader}"><TextBlock Text="줄 단위 편집" FontSize="17"/></Border></DockPanel>
                                        <ComboBox x:Name="TrimOperationCombo" Margin="0,6,0,0" SelectionChanged="TrimOperationCombo_SelectionChanged">
                                            <ComboBoxItem Content="기준 앞 텍스트 삭제" IsSelected="True" />
                                            <ComboBoxItem Content="기준 뒤 텍스트 삭제" />
                                            <ComboBoxItem Content="두 기준 사이 삭제" />
                                            <ComboBoxItem Content="두 기준 사이만 남기기" />
                                            <ComboBoxItem Content="왼쪽 글자 수만큼 삭제" />
                                            <ComboBoxItem Content="오른쪽 글자 수만큼 삭제" />
                                            <ComboBoxItem Content="각 줄 앞에 텍스트 추가" />
                                            <ComboBoxItem Content="각 줄 뒤에 텍스트 추가" />
                                            <ComboBoxItem Content="구분자로 줄 나누기" />
                                            <ComboBoxItem Content="여러 줄을 한 줄로 합치기" />
                                            <ComboBoxItem Content="줄 번호 추가" />
                                            <ComboBoxItem Content="줄 번호 제거" />
                                        </ComboBox>
                                        <StackPanel x:Name="MarkerInputsPanel">
                                            <TextBlock Text="시작 기준" Margin="0,10,0,4" />
                                            <TextBox x:Name="StartMarkerBox" />
                                            <StackPanel x:Name="EndMarkerPanel" Visibility="Collapsed">
                                                <TextBlock Text="종료 기준" Margin="0,10,0,4" />
                                                <TextBox x:Name="EndMarkerBox" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="CharacterCountPanel" Visibility="Collapsed"><TextBlock Text="삭제할 글자 수" Margin="0,10,0,4"/><TextBox x:Name="CharacterCountBox" Text="1"/></StackPanel>
                                        <StackPanel x:Name="ValueInputPanel" Visibility="Collapsed"><TextBlock x:Name="ValueInputLabel" Text="추가할 텍스트" Margin="0,10,0,4"/><TextBox x:Name="ValueInputBox"/></StackPanel>
                                        <StackPanel x:Name="LineNumberPanel" Visibility="Collapsed">
                                            <StackPanel x:Name="StartNumberPanel">
                                                <TextBlock Text="시작 번호" Margin="0,10,0,4"/><TextBox x:Name="StartNumberBox" Text="1"/>
                                            </StackPanel>
                                            <TextBlock Text="번호 구분자" Margin="0,8,0,4"/><TextBox x:Name="LineNumberSeparatorBox" Text=": "/>
                                        </StackPanel>
                                        <WrapPanel x:Name="TrimOptionsPanel" Margin="0,6">
                                            <CheckBox x:Name="KeepStartCheck" Content="시작 기준 유지" IsChecked="True" />
                                            <CheckBox x:Name="KeepEndCheck" Content="종료 기준 유지" IsChecked="True" Visibility="Collapsed" />
                                            <CheckBox x:Name="TrimMatchCaseCheck" Content="대소문자 구분" ToolTip="켜면 ABC와 abc를 서로 다른 텍스트로 검색합니다." />
                                        </WrapPanel>
                                        <CheckBox x:Name="IncludeBlankLinesCheck" Content="빈 줄에도 적용" Visibility="Collapsed" Margin="0,4"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Style="{StaticResource TransformActionButton}" Content="미리보기" Click="PreviewTrim_Click" />
                                            <Button Style="{StaticResource TransformActionButton}" Content="바로 적용" Click="ApplyTrimDirect_Click" ToolTip="확인창 없이 적용하며 Ctrl+Z로 되돌릴 수 있습니다." />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCard}" Padding="8">
                                    <StackPanel>
                                        <Border Style="{StaticResource PanelSectionHeader}"><TextBlock Text="빠른 정리" FontSize="17"/></Border>
                                        <Grid Margin="0,0,0,4" SizeChanged="QuickTransformRow_SizeChanged">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Button Content="중복 줄 제거" Style="{StaticResource PanelFunctionTitle}" Tag="같은 내용은 처음 나온 줄만 남깁니다. 대소문자는 구분하지 않고 앞뒤 공백은 구분합니다." Loaded="TransformTitleHelp_Loaded" Focusable="False"/>
                                            <WrapPanel Grid.Column="1"><Button Style="{StaticResource TransformActionButton}" Content="미리보기" Tag="Duplicate" ToolTip="같은 내용은 처음 나온 줄만 남깁니다. 대소문자는 구분하지 않고 앞뒤 공백은 구분합니다." Click="QuickTransform_Click"/><Button Style="{StaticResource TransformActionButton}" Content="바로 적용" Tag="Duplicate" ToolTip="확인창 없이 적용합니다. Ctrl+Z로 되돌립니다." Click="ApplyQuickTransform_Click"/></WrapPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,4" SizeChanged="QuickTransformRow_SizeChanged">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Button Content="빈 줄 모두 제거" Style="{StaticResource PanelFunctionTitle}" Tag="내용이 없거나 공백·탭만 있는 줄을 모두 삭제합니다." Loaded="TransformTitleHelp_Loaded" Focusable="False"/>
                                            <WrapPanel Grid.Column="1"><Button Style="{StaticResource TransformActionButton}" Content="미리보기" Tag="Blank" ToolTip="내용이 없거나 공백·탭만 있는 줄을 모두 삭제합니다." Click="QuickTransform_Click"/><Button Style="{StaticResource TransformActionButton}" Content="바로 적용" Tag="Blank" ToolTip="확인창 없이 적용합니다. Ctrl+Z로 되돌립니다." Click="ApplyQuickTransform_Click"/></WrapPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,4" SizeChanged="QuickTransformRow_SizeChanged">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Button Content="연속 빈 줄을 한 줄로" Style="{StaticResource PanelFunctionTitle}" Tag="이어진 빈 줄을 첫 빈 줄 하나로 줄입니다. 한 줄씩 떨어진 빈 줄은 유지합니다." Loaded="TransformTitleHelp_Loaded" Focusable="False"/>
                                            <WrapPanel Grid.Column="1"><Button Style="{StaticResource TransformActionButton}" Content="미리보기" Tag="Collapse" ToolTip="이어진 빈 줄을 첫 빈 줄 하나로 줄입니다. 한 줄씩 떨어진 빈 줄은 유지합니다." Click="QuickTransform_Click"/><Button Style="{StaticResource TransformActionButton}" Content="바로 적용" Tag="Collapse" ToolTip="확인창 없이 적용합니다. Ctrl+Z로 되돌립니다." Click="ApplyQuickTransform_Click"/></WrapPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,4" SizeChanged="QuickTransformRow_SizeChanged">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Button Content="줄 공백 정리" Style="{StaticResource PanelFunctionTitle}" Tag="기본은 줄 끝 공백·탭만 제거합니다. 앞뒤 모두를 선택하면 들여쓰기도 제거합니다." Loaded="TransformTitleHelp_Loaded" Focusable="False"/>
                                            <WrapPanel Grid.Column="1"><Button Style="{StaticResource TransformActionButton}" Content="미리보기" Tag="Whitespace" ToolTip="기본은 줄 끝 공백·탭만 제거합니다. 앞뒤 모두를 선택하면 들여쓰기도 제거합니다." Click="QuickTransform_Click"/><Button Style="{StaticResource TransformActionButton}" Content="바로 적용" Tag="Whitespace" ToolTip="확인창 없이 적용합니다. Ctrl+Z로 되돌립니다." Click="ApplyQuickTransform_Click"/></WrapPanel>
                                        </Grid>

                                        <ComboBox x:Name="QuickWhitespaceMode" HorizontalAlignment="Left" Margin="0,0,0,4" AutomationProperties.Name="줄 공백 정리 범위"><ComboBoxItem Content="줄 끝만" IsSelected="True"/><ComboBoxItem Content="앞뒤 모두"/></ComboBox>
                                        <Separator Margin="0,6" />
                                        <Button Content="특정 텍스트 포함 줄 삭제" Style="{StaticResource PanelFunctionTitle}" Tag="입력한 텍스트가 있는 줄 전체를 삭제합니다. 대소문자 구분 옵션을 따릅니다.&#10;예: ERROR 포함 줄 삭제" Loaded="TransformTitleHelp_Loaded" Focusable="False"/>
                                        <TextBlock Text="줄에서 찾을 텍스트" Margin="0,7,0,3" /><TextBox x:Name="DeleteContainingBox" ToolTip="예: 연결 시간 초과" />
                                        <CheckBox x:Name="DeleteContainingMatchCaseCheck" Content="대소문자 구분" ToolTip="켜면 ABC와 abc를 서로 다른 텍스트로 검색합니다." />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Style="{StaticResource TransformActionButton}" Content="삭제 미리보기" Tag="DeleteContaining" Foreground="{DynamicResource DangerBrush}" Click="PreviewDeleteContaining_Click" />
                                            <Button Style="{StaticResource TransformActionButton}" Content="바로 삭제" Foreground="{DynamicResource DangerBrush}" Click="ApplyDeleteContainingDirect_Click" ToolTip="확인창 없이 적용하며 Ctrl+Z로 되돌릴 수 있습니다." />
                                        </WrapPanel>
                                        <Separator Margin="0,6" />
                                        <Button Content="일괄 치환" Style="{StaticResource PanelFunctionTitle}" Tag="일치하는 텍스트를 모두 바꿉니다. 대소문자는 구분하지 않습니다. 바꿀 텍스트를 비우면 삭제합니다.&#10;예: apple → 사과" Loaded="TransformTitleHelp_Loaded" Focusable="False"/>
                                        <TextBlock Text="찾을 텍스트" Margin="0,7,0,3" /><TextBox x:Name="ReplaceFromBox" />
                                        <TextBlock Text="바꿀 텍스트" Margin="0,7,0,3" /><TextBox x:Name="ReplaceToBox" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Style="{StaticResource TransformActionButton}" Content="치환 미리보기" Click="PreviewReplace_Click" />
                                            <Button Style="{StaticResource TransformActionButton}" Content="바로 치환" Click="ApplyReplaceDirect_Click" ToolTip="확인창 없이 적용하며 Ctrl+Z로 되돌릴 수 있습니다." />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="0" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" DragCompleted="PanelSplitter_DragCompleted" />
            <Border x:Name="ResultRestoreBar" Grid.Row="2" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}">
                <Button x:Name="RestoreResultsButton" Content="검색 결과 펼치기 ▴" HorizontalAlignment="Left" Padding="9,1" Margin="3,0" MinHeight="26" Click="RestoreResults_Click" ToolTip="접어 둔 검색 결과와 미리보기 다시 표시" />
            </Border>
            <Border x:Name="ResultPanel" Grid.Row="2" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <DockPanel x:Name="SearchResultsView">
                        <DockPanel.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.Copy" CanExecute="CopyResultCommand_CanExecute" Executed="CopyResultCommand_Executed" />
                        </DockPanel.CommandBindings>
                        <Border x:Name="ResultsCommandBar" DockPanel.Dock="Top" Padding="4,2" Background="{DynamicResource SurfaceAltBrush}" ToolTip="{Binding Text, ElementName=SearchSessionStatus}">
                            <DockPanel LastChildFill="True">
                                <DockPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="2,0"/><Setter Property="MinHeight" Value="26"/></Style>
                                </DockPanel.Resources>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="DetachResultsButton" Content="↗" Click="DetachResults_Click" ToolTip="검색 결과를 별도 창으로 보기 / 본창으로 되돌리기" />
                                    <Button Content="—" Click="MinimizeResults_Click" ToolTip="검색 결과를 아래로 접기" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button x:Name="CopyAllResultsButton" Content="전체 복사" Style="{StaticResource PrimaryButton}" Padding="6,2" Margin="2,0" MinHeight="26" ToolTip="현재 검색 탭의 모든 일치 행 복사" Click="CopyAllResults_Click" />
                                    <Button x:Name="ExtractAllButton" Content="전체 새 문서" ToolTip="모든 일치 행의 본문만 새 문서로 복사" Click="ExtractAllResults_Click" />
                                    <Button x:Name="CopySelectedResultsButton" Content="선택 복사" ToolTip="선택한 결과 행 복사 (결과 목록에서 Ctrl+C)" Click="CopySelectedResults_Click" />
                                    <Button x:Name="ExtractSelectedButton" Content="선택 새 문서" ToolTip="선택한 일치 행의 본문만 새 문서로 복사" Click="ExtractSelectedResults_Click" />
                                    <Menu VerticalAlignment="Center" Background="Transparent" Margin="2,0">
                                        <MenuItem Header="더 보기 ▾" ToolTip="삭제 미리보기와 검색 결과 탭 닫기">
                                            <MenuItem StaysOpenOnClick="True"><MenuItem.Header><CheckBox x:Name="IncludeLineNumbersCheck" Content="복사 시 줄 번호 포함" Checked="IncludeLineNumbers_Changed" Unchecked="IncludeLineNumbers_Changed" /></MenuItem.Header></MenuItem>
                                            <Separator/>
                                            <MenuItem x:Name="DeleteSelectedButton" Header="선택 행 삭제 미리보기" Foreground="{DynamicResource DangerBrush}" Click="DeleteSelectedResults_Click" />
                                            <MenuItem x:Name="DeleteAllButton" Header="전체 일치 행 삭제 미리보기" Foreground="{DynamicResource DangerBrush}" Click="DeleteAllResults_Click" />
                                            <Separator/>
                                            <MenuItem Header="다른 결과 닫기" Click="CloseOtherResults_Click" />
                                            <MenuItem Header="모든 검색 결과 닫기" Click="CloseAllResults_Click" />
                                        </MenuItem>
                                    </Menu>
                                </StackPanel>
                                <TextBlock x:Name="SearchSessionStatus" Text="검색 결과" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="5,0" />
                            </DockPanel>
                        </Border>
                        <TabControl x:Name="SearchResultTabs" ItemsSource="{Binding SearchSessions}" SelectionChanged="SearchResultTabs_SelectionChanged">
                            <TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="12"/></Style></TabControl.ItemContainerStyle>
                            <TabControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                <StackPanel.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="결과 닫기" Click="SearchTabMenuClose_Click"/>
                                    <MenuItem Header="이 창을 제외하고 모두 닫기" Click="SearchTabMenuCloseOthers_Click"/>
                                    <MenuItem Header="모든 결과 닫기" Click="SearchTabMenuCloseAll_Click"/>
                                    <Separator/>
                                    <MenuItem Header="검색 조건 복사" Click="SearchTabMenuCopyCondition_Click"/>
                                </ContextMenu></StackPanel.ContextMenu>
                                <TextBlock Text="{Binding Title}" Margin="0,0,7,0" VerticalAlignment="Center"/><Button Content="×" Tag="{Binding}" Padding="2,0" MinHeight="18" Height="18" Margin="0" Background="Transparent" BorderThickness="0" Click="SearchResultClose_Click"/></StackPanel></DataTemplate></TabControl.ItemTemplate>
                            <TabControl.ContentTemplate><DataTemplate><DockPanel Grid.IsSharedSizeScope="True">
                                <Grid DockPanel.Dock="Top" Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto" MinWidth="94" SharedSizeGroup="ResultLineNumberColumn"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="원본 줄 번호"/><TextBlock Grid.Column="2" Text="파일"/><TextBlock Grid.Column="3" Text="내용"/></Grid>
                                <ListBox ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SearchResultRowTemplate}" ItemContainerStyle="{StaticResource CompactSearchResultItem}" SelectionMode="Extended"
                                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         Loaded="SearchResultsList_Loaded" Unloaded="SearchResultsList_Unloaded" SelectionChanged="SearchResultsList_SelectionChanged"
                                         PreviewMouseUp="SearchResultsList_MouseLeftButtonUp" MouseDoubleClick="SearchResultsList_MouseDoubleClick" PreviewKeyDown="SearchResultsList_KeyDown" />
                            </DockPanel></DataTemplate></TabControl.ContentTemplate>
                        </TabControl>
                    </DockPanel>
                    <DockPanel x:Name="TransformPreviewView" Visibility="Collapsed">
                        <Border DockPanel.Dock="Top" Padding="9,5" Background="{DynamicResource SurfaceAltBrush}">
                            <DockPanel><TextBlock x:Name="ResultHeader" Text="변경 미리보기" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ComboBox x:Name="PreviewFilterCombo" Width="92" ToolTip="미리보기 행 필터" SelectionChanged="PreviewFilterCombo_SelectionChanged"><ComboBoxItem Content="전체" IsSelected="True"/><ComboBoxItem Content="변경"/><ComboBoxItem Content="건너뜀"/></ComboBox>
                                <Button x:Name="PreviewUndoButton" Content="실행 취소" Click="Undo_Click" ToolTip="현재 문서의 최근 편집을 되돌립니다 (Ctrl+Z)" />
                                <Button x:Name="ApplyTransformButton" Content="변경 적용" Style="{StaticResource PrimaryButton}" Click="ApplyTransform_Click" />
                                <Button Content="미리보기 닫기" Click="ClosePreview_Click" />
                            </StackPanel></DockPanel>
                        </Border>
                        <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="줄" Binding="{Binding LineNumber}" Width="55" />
                                <DataGridTextColumn Header="변경 전" Binding="{Binding Before}" Width="*" />
                                <DataGridTextColumn Header="변경 후" Binding="{Binding After}" Width="*" />
                                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
