<Window x:Class="MyTextEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MyTextEditor.Models"
        Title="나만의 텍스트 편집기" MinWidth="1040" MinHeight="680"
        Width="1380" Height="860" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" KeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <DataTemplate DataType="{x:Type models:SearchResultRow}">
            <Grid Margin="4,2"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultMarker" Text="●" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                <TextBlock x:Name="ResultLineNumber" Grid.Column="1" Text="{Binding LineNumber}" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Mono, Consolas" />
                <TextBlock x:Name="ResultText" Grid.Column="2" Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsContext}" Value="True">
                    <Setter TargetName="ResultMarker" Property="Text" Value="↳" />
                    <Setter TargetName="ResultMarker" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter TargetName="ResultLineNumber" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter TargetName="ResultText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter TargetName="ResultText" Property="Margin" Value="6,0,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Background="{DynamicResource WindowBrush}">
        <Menu DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="새 문서(_N)" InputGestureText="Ctrl+N" Click="New_Click" />
                <MenuItem Header="열기(_O)…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <Separator />
                <MenuItem Header="저장(_S)" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem Header="다른 이름으로 저장(_A)…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                <Separator />
                <MenuItem x:Name="RecentFilesMenu" Header="최근 파일" />
                <Separator />
                <MenuItem Header="현재 탭 닫기(_W)" InputGestureText="Ctrl+W" Click="CloseTab_Click" />
                <MenuItem Header="끝내기(_X)" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem Header="실행 취소" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem Header="다시 실행" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="모두 선택" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem x:Name="ToolsMenuItem" Header="도구 패널" IsCheckable="True" IsChecked="True" Click="ToggleTools_Click" />
                <MenuItem x:Name="ResultsMenuItem" Header="결과 패널" IsCheckable="True" IsChecked="False" Click="ToggleResults_Click" />
                <Separator />
                <MenuItem Header="라이트 테마" Click="LightTheme_Click" />
                <MenuItem Header="다크 테마" Click="DarkTheme_Click" />
            </MenuItem>
            <MenuItem Header="도움말(_H)" Click="Help_Click" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="StatusMessage" Text="준비" /></StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="CaretStatus" Text="줄 1, 열 1" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="LineCountStatus" Text="1줄" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="EncodingStatus" Text="UTF-8" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="NewLineStatus" Text="CRLF" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top" Padding="8,2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="새 문서" ToolTip="새 문서 (Ctrl+N)" Click="New_Click" />
                    <Button Content="열기" ToolTip="파일 열기 (Ctrl+O)" Click="Open_Click" />
                    <Button Content="저장" ToolTip="저장 (Ctrl+S)" Click="Save_Click" />
                    <Border Width="1" Margin="8,3" Background="{DynamicResource BorderBrush}" />
                    <Button Style="{StaticResource IconButton}" Content="↶" ToolTip="실행 취소 (Ctrl+Z)" Click="Undo_Click" />
                    <Button Style="{StaticResource IconButton}" Content="↷" ToolTip="다시 실행 (Ctrl+Y)" Click="Redo_Click" />
                </StackPanel>
                <StackPanel x:Name="ToolbarFontPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="글꼴" Margin="8,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox x:Name="FontFamilyCombo" Width="150" Height="28" IsEditable="True" IsTextSearchEnabled="True"
                              ToolTip="설치된 글꼴 검색" SelectionChanged="FontFamilyCombo_SelectionChanged" LostKeyboardFocus="FontFamilyCombo_LostKeyboardFocus" />
                    <TextBlock Text="크기" Margin="8,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox x:Name="FontSizeCombo" Width="64" Height="28" SelectionChanged="FontSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15" IsSelected="True"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/>
                    </ComboBox>
                    <Button Content="◐" ToolTip="라이트/다크 테마 전환" Click="ToggleTheme_Click" />
                </StackPanel>
                <StackPanel x:Name="ToolbarOverflowPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button x:Name="ToolbarOverflowButton" Content="글꼴 · 크기 ⋯" Height="28" ToolTip="글꼴과 크기 설정" Click="ToolbarOverflowButton_Click" />
                    <Button Content="◐" Height="28" ToolTip="라이트/다크 테마 전환" Click="ToggleTheme_Click" />
                    <Popup x:Name="ToolbarOverflowPopup" PlacementTarget="{Binding ElementName=ToolbarOverflowButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Padding="10" Margin="0,4,0,0" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Width="230">
                                <TextBlock Text="글꼴" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                                <ComboBox x:Name="OverflowFontFamilyCombo" Height="28" IsEditable="True" IsTextSearchEnabled="True"
                                          ToolTip="설치된 글꼴 검색" SelectionChanged="OverflowFontFamilyCombo_SelectionChanged" LostKeyboardFocus="OverflowFontFamilyCombo_LostKeyboardFocus" />
                                <TextBlock Text="크기" Margin="0,8,0,4" Foreground="{DynamicResource MutedBrush}" />
                                <ComboBox x:Name="OverflowFontSizeCombo" Height="28" SelectionChanged="OverflowFontSizeCombo_SelectionChanged">
                                    <ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15" IsSelected="True"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ToolSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="ToolColumn" Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="ResultSplitterRow" Height="0" />
                <RowDefinition x:Name="ResultRow" Height="0" MinHeight="0" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                <Grid>
                    <TabControl x:Name="DocumentTabs" ItemsSource="{Binding Documents}" SelectionChanged="DocumentTabs_SelectionChanged">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TabTitle}" Margin="0,0,8,0" />
                                    <Button Content="×" Padding="2,0" Margin="0" Background="Transparent" BorderThickness="0"
                                            ToolTip="탭 닫기" Tag="{Binding}" Click="TabClose_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Editor}" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <Border x:Name="EmptyDocumentState" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
                            <Viewbox Width="72" Height="72" Margin="0,0,0,18">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M14,5 H39 L52,18 V58 H14 Z" Fill="{DynamicResource SelectionBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
                                    <Path Data="M39,5 V18 H52 M23,30 H43 M23,39 H43 M23,48 H36" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="새 문서에서 시작하세요" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="파일을 열거나 새 문서를 만들어 검색과 텍스트 정리 도구를 사용해 보세요." Margin="0,10" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="새 문서" Style="{StaticResource PrimaryButton}" Click="New_Click" />
                                <Button Content="파일 열기" Click="Open_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

            <Border x:Name="ToolPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <TabControl Margin="0" x:Name="ToolTabs">
                    <TabItem Header="조건 검색">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="검색 조건" FontSize="17" FontWeight="SemiBold" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button x:Name="SimpleModeButton" Content="간편" MinHeight="36" Click="SimpleMode_Click" />
                                                <Button x:Name="AdvancedModeButton" Content="고급" MinHeight="36" Click="AdvancedMode_Click" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel x:Name="SimpleConditionsPanel">
                                            <TextBlock Text="쉼표로 여러 검색어를 구분할 수 있습니다." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                                            <TextBlock Text="모두 포함" Margin="0,5,0,3"/><TextBox x:Name="SimpleAllBox" ToolTip="예: AAA, BBB — 쉼표로 추가" TextChanged="SimpleCondition_TextChanged" KeyDown="SearchInput_KeyDown"/>
                                            <WrapPanel x:Name="SimpleAllTags" Margin="0,4,0,0" />
                                            <TextBlock Text="하나라도 포함" Margin="0,8,0,3"/><TextBox x:Name="SimpleAnyBox" ToolTip="예: 오류, 경고 — 쉼표로 추가" TextChanged="SimpleCondition_TextChanged" KeyDown="SearchInput_KeyDown"/>
                                            <WrapPanel x:Name="SimpleAnyTags" Margin="0,4,0,0" />
                                            <TextBlock Text="제외" Margin="0,8,0,3"/><TextBox x:Name="SimpleExcludeBox" ToolTip="예: 테스트 — 쉼표로 추가" TextChanged="SimpleCondition_TextChanged" KeyDown="SearchInput_KeyDown"/>
                                            <WrapPanel x:Name="SimpleExcludeTags" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel x:Name="AdvancedConditionsPanel" Visibility="Collapsed">
                                            <TextBlock Text="각 카드에서 조건과 하위 그룹을 바로 추가할 수 있습니다." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            <StackPanel x:Name="AdvancedConditionsHost" />
                                        </StackPanel>
                                        <Border Margin="0,10,0,0" Padding="9" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}">
                                            <TextBlock x:Name="ConditionSummaryText" Text="검색 조건을 입력하세요." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Text="검색 옵션" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <CheckBox x:Name="MatchCaseCheck" Content="대소문자 구분" />
                                            <CheckBox x:Name="WholeWordCheck" Content="완전한 단어" />
                                        </WrapPanel>
                                        <DockPanel Margin="4,4">
                                            <TextBlock Text="위·아래 문맥" />
                                            <ComboBox x:Name="ContextLinesCombo" Width="70" HorizontalAlignment="Right">
                                                <ComboBoxItem Content="0" IsSelected="True"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="5"/>
                                            </ComboBox>
                                        </DockPanel>
                                        <Button x:Name="SearchButton" Content="찾기" Style="{StaticResource PrimaryButton}" IsEnabled="False" ToolTip="Enter로도 검색할 수 있습니다." Click="Search_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="텍스트 정리">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Text="유용한 기능" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="각 줄을 기준으로 자르기·꾸미기·분할 작업을 적용합니다." Margin="0,5,0,10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                        <ComboBox x:Name="TrimOperationCombo" SelectionChanged="TrimOperationCombo_SelectionChanged">
                                            <ComboBoxItem Content="머리 자르기 · 기준 앞 제거" IsSelected="True" />
                                            <ComboBoxItem Content="꼬리 자르기 · 기준 뒤 제거" />
                                            <ComboBoxItem Content="두 기준 사이 지우기" />
                                            <ComboBoxItem Content="두 기준 사이만 남기기" />
                                            <ComboBoxItem Content="왼쪽 글자 수만큼 삭제" />
                                            <ComboBoxItem Content="오른쪽 글자 수만큼 삭제" />
                                            <ComboBoxItem Content="각 줄 앞에 텍스트 추가" />
                                            <ComboBoxItem Content="각 줄 뒤에 텍스트 추가" />
                                            <ComboBoxItem Content="구분자로 줄 나누기" />
                                            <ComboBoxItem Content="여러 줄을 한 줄로 합치기" />
                                            <ComboBoxItem Content="줄 번호 추가" />
                                            <ComboBoxItem Content="줄 번호 제거" />
                                        </ComboBox>
                                        <StackPanel x:Name="MarkerInputsPanel">
                                            <TextBlock Text="시작 기준" Margin="0,10,0,4" />
                                            <TextBox x:Name="StartMarkerBox" />
                                            <StackPanel x:Name="EndMarkerPanel" Visibility="Collapsed">
                                                <TextBlock Text="종료 기준" Margin="0,10,0,4" />
                                                <TextBox x:Name="EndMarkerBox" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="CharacterCountPanel" Visibility="Collapsed"><TextBlock Text="삭제할 글자 수" Margin="0,10,0,4"/><TextBox x:Name="CharacterCountBox" Text="1"/></StackPanel>
                                        <StackPanel x:Name="ValueInputPanel" Visibility="Collapsed"><TextBlock x:Name="ValueInputLabel" Text="추가할 텍스트" Margin="0,10,0,4"/><TextBox x:Name="ValueInputBox"/></StackPanel>
                                        <StackPanel x:Name="LineNumberPanel" Visibility="Collapsed">
                                            <StackPanel x:Name="StartNumberPanel">
                                                <TextBlock Text="시작 번호" Margin="0,10,0,4"/><TextBox x:Name="StartNumberBox" Text="1"/>
                                            </StackPanel>
                                            <TextBlock Text="번호 구분자" Margin="0,8,0,4"/><TextBox x:Name="LineNumberSeparatorBox" Text=": "/>
                                        </StackPanel>
                                        <WrapPanel x:Name="TrimOptionsPanel" Margin="0,6">
                                            <CheckBox x:Name="KeepStartCheck" Content="시작 기준 유지" IsChecked="True" />
                                            <CheckBox x:Name="KeepEndCheck" Content="종료 기준 유지" IsChecked="True" Visibility="Collapsed" />
                                            <CheckBox x:Name="TrimMatchCaseCheck" Content="대소문자 구분" />
                                        </WrapPanel>
                                        <CheckBox x:Name="IncludeBlankLinesCheck" Content="빈 줄에도 적용" Visibility="Collapsed" Margin="0,4"/>
                                        <Button Content="미리보기" Style="{StaticResource PrimaryButton}" Click="PreviewTrim_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Text="빠른 정리" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <UniformGrid Columns="2">
                                            <Button Content="중복 줄 제거" Tag="Duplicate" Click="QuickTransform_Click" />
                                            <Button Content="빈 줄 제거" Tag="Blank" Click="QuickTransform_Click" />
                                            <Button Content="빈 줄 합치기" Tag="Collapse" Click="QuickTransform_Click" />
                                            <Button Content="앞뒤 공백 제거" Tag="Whitespace" Click="QuickTransform_Click" />
                                        </UniformGrid>
                                        <Separator Margin="0,10" />
                                        <TextBlock Text="일괄 치환" FontWeight="SemiBold" />
                                        <TextBlock Text="찾을 텍스트" Margin="0,7,0,3" /><TextBox x:Name="ReplaceFromBox" />
                                        <TextBlock Text="바꿀 텍스트" Margin="0,7,0,3" /><TextBox x:Name="ReplaceToBox" />
                                        <Button Content="치환 미리보기" Click="PreviewReplace_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="0" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
            <Border x:Name="ResultPanel" Grid.Row="2" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="9,5" Background="{DynamicResource SurfaceAltBrush}">
                        <DockPanel>
                            <TextBlock x:Name="ResultHeader" Text="검색 결과" FontWeight="SemiBold" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox x:Name="PreviewFilterCombo" Width="92" ToolTip="미리보기 행 필터" Visibility="Collapsed" SelectionChanged="PreviewFilterCombo_SelectionChanged">
                                    <ComboBoxItem Content="전체" IsSelected="True"/><ComboBoxItem Content="변경"/><ComboBoxItem Content="건너뜀"/>
                                </ComboBox>
                                <Button x:Name="CopyResultsButton" Content="결과 복사" ToolTip="일치한 줄만 클립보드에 복사" Click="CopyResults_Click" />
                                <Button x:Name="ExtractResultsButton" Content="새 탭으로 추출" ToolTip="일치한 줄을 새 문서로 만들기" Click="ExtractResults_Click" />
                                <Button x:Name="DeleteResultsButton" Content="일치 줄 삭제" ToolTip="미리보기 후 일치 줄 삭제" Foreground="{DynamicResource DangerBrush}" Click="DeleteResults_Click" />
                                <Button x:Name="ApplyTransformButton" Content="변경 적용" ToolTip="미리보기 내용을 현재 문서에 적용" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="ApplyTransform_Click" />
                                <Button x:Name="ResetResultsButton" Content="초기화" ToolTip="현재 검색 결과 또는 미리보기 닫기" Click="ResetResults_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}" SelectionChanged="SearchResultsList_SelectionChanged" />
                        <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="줄" Binding="{Binding LineNumber}" Width="55" />
                                <DataGridTextColumn Header="변경 전" Binding="{Binding Before}" Width="*" />
                                <DataGridTextColumn Header="변경 후" Binding="{Binding After}" Width="*" />
                                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
