<Window x:Class="MyTextEditor.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTextEditor 도움말" Width="1040" Height="720" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        Loaded="Window_Loaded" LocationChanged="Window_PlacementChanged" SizeChanged="Window_PlacementChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="HelpHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,22,0,7"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="18,13" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="도움말" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="기능 사용법과 단축키를 찾아보세요." Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox" Height="34" Padding="10,5,34,5"
                             ToolTip="도움말 검색 (Ctrl+F)" TextChanged="SearchBox_TextChanged"/>
                    <Button x:Name="ClearSearchButton" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,4,4,4"
                            Padding="0" Content="×" ToolTip="검색어 지우기" Visibility="Collapsed" Click="ClearSearch_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="210"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Margin="14,12,14,8" Text="목차" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    <ListBox x:Name="TopicList" Grid.Row="1" Margin="8,0,8,10" BorderThickness="0"
                             SelectionChanged="TopicList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Margin="5,3" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>

            <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <ScrollViewer x:Name="TopicScroll" VerticalScrollBarVisibility="Auto" Padding="34,24,42,36">
                    <StackPanel x:Name="TopicContent" MaxWidth="850" HorizontalAlignment="Left">
                        <TextBlock x:Name="TopicTitle" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TopicSummary" Margin="0,8,0,4" FontSize="14" LineHeight="22"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="SectionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" Style="{StaticResource HelpHeading}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Body}" FontSize="14" LineHeight="22" TextWrapping="Wrap"/>
                                        <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="5"
                                                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Example}" FontFamily="{DynamicResource EditorFontFamily}" FontSize="13"
                                                       LineHeight="20" TextWrapping="Wrap"/>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Example}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="NoResultsPanel" Width="390" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="62" Height="62" CornerRadius="31" Background="{DynamicResource SelectionBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="?" FontSize="31" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="일치하는 도움말이 없습니다" Margin="0,16,0,5" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="다른 검색어를 입력하거나 전체 목차로 돌아가세요." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="검색 초기화" Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="ClearSearch_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
